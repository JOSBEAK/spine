# Copy to .env for local overrides (npm start / npm run dev read it). Never commit .env.

# Postgres connection string. Leave empty to use embedded PGlite stored in server/.data/.
# Neon: use the pooled connection string, e.g.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/spine?sslmode=require
DATABASE_URL=

# Comma-separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=https://josbeak.github.io,http://localhost:5178,http://localhost:5173

# Local port (npm start).
PORT=8787

# Where PGlite keeps its files when DATABASE_URL is empty. Default: server/.data
# PGLITE_DIR=

# Trust X-Forwarded-For for the login rate limit. Defaults to on when running on Vercel, off elsewhere.
# Turn it on only behind a proxy that sets the header itself.
# TRUST_PROXY=

# Max Postgres connections per server instance (default 5).
# DATABASE_POOL_SIZE=5

# CSV imports stop starting new Open Library lookups after this many ms (default 240000).
# Keep it below the function's maxDuration in vercel.json.
# IMPORT_BUDGET_MS=240000
